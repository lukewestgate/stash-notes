{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stash Notes",
  "mainBinaryName": "stash-notes",
  "version": "0.10.3",
  "identifier": "com.lukewestgate.stashnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Stash Notes",
        "width": 900,
        "height": 650,
        "minWidth": 420,
        "minHeight": 280,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "quick",
        "title": "Quick switcher",
        "url": "index.html",
        "width": 620,
        "height": 420,
        "minWidth": 400,
        "minHeight": 60,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Keyboard-first, always-resident notepad for work",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
